/* ============================================================
   Serene Guardian · 全局样式（微信小程序版）
   深松绿主色 / 大圆角 / 植物系柔和阴影 / 移动优先
   ============================================================ */
page{
  --primary:#FE8E28; --primary-dark:#C2410C; --mint:#FFF7E8; --mint-line:#F6D9A8; --teal-soft:#FBE693; --teal-2:#F59E0B;
  --green:#059669; --green-bg:#ECFDF5; --red:#DC2626; --red-2:#EF4444; --red-bg:#FEF2F2; --amber:#D97706; --amber-bg:#FEF3C7;
  --ink:#0F172A; --ink-2:#334155; --muted:#64748B; --line:#F0E3CE; --bg:#FDF8EF;
  background:var(--bg); color:var(--ink);
  font-family:"PingFang SC","Microsoft YaHei",system-ui,sans-serif;
  font-size:28rpx; line-height:1.6;
}
view,text,button,input,textarea,picker,scroll-view,map{box-sizing:border-box}
button{margin:0;padding:0;background:none;border:none;line-height:1.5;font-size:28rpx;color:inherit;text-align:center}
button::after{border:none}
input,textarea{font-size:28rpx;color:var(--ink)}

.page{min-height:100vh;padding:20rpx 24rpx 140rpx}
.pad-b{height:40rpx}
.spacer{flex:1}

/* ---- 卡片 ---- */
.card{background:#fff;border:2rpx solid var(--line);border-radius:32rpx;padding:28rpx;margin-bottom:24rpx;
  box-shadow:0 8rpx 24rpx -8rpx rgba(15,23,42,.05)}
.card-h{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}
.card-h .b{font-size:30rpx;font-weight:700;color:var(--ink)}
.card-h .more{font-size:24rpx;color:var(--muted)}

/* ---- 徽章/Chip ---- */
.chip{display:inline-flex;align-items:center;background:#FAF0DE;color:var(--ink-2);border-radius:999rpx;
  padding:6rpx 18rpx;font-size:22rpx;font-weight:600;white-space:nowrap}
.chip.green{background:var(--green-bg);color:var(--green)}
.chip.red{background:var(--red-bg);color:var(--red)}
.chip.amber{background:var(--amber-bg);color:var(--amber)}
.chip.mint{background:var(--mint);color:var(--primary-dark);border:2rpx solid var(--mint-line)}

/* ---- 按钮 ---- */
.btn-primary{background:var(--primary);color:#fff;border-radius:999rpx;min-height:88rpx;display:flex;align-items:center;justify-content:center;
  font-size:30rpx;font-weight:700;padding:0 32rpx}
.btn-primary:active{opacity:.88}
.btn-green{background:var(--green);color:#fff;border-radius:999rpx;min-height:88rpx;display:flex;align-items:center;justify-content:center;font-weight:700;padding:0 32rpx}
.btn-red{background:var(--red);color:#fff;border-radius:999rpx;min-height:88rpx;display:flex;align-items:center;justify-content:center;font-weight:700;padding:0 32rpx}
.btn-outline{border:2rpx solid var(--line);color:var(--ink-2);border-radius:999rpx;min-height:80rpx;display:flex;align-items:center;justify-content:center;
  font-size:28rpx;font-weight:600;padding:0 28rpx;background:#fff}
.btn-outline:active{background:#FBF4E6}
.btn-mint{background:var(--teal-soft);color:var(--primary-dark);border-radius:999rpx;padding:0 30rpx;min-height:88rpx;
  display:flex;align-items:center;justify-content:center;font-weight:700;font-size:26rpx;white-space:nowrap}
.btn-ghost{color:var(--muted);min-height:80rpx;display:flex;align-items:center;justify-content:center;font-size:28rpx}
.btn-block{width:100%}
.btn-warn{background:var(--amber-bg);color:var(--amber);border-radius:999rpx;min-height:80rpx;display:flex;align-items:center;justify-content:center;
  font-weight:700;font-size:26rpx;padding:0 24rpx;border:2rpx solid #FDE68A}
.mt10{margin-top:20rpx}.mt12{margin-top:24rpx}

/* ---- 表单 ---- */
.field{margin-bottom:24rpx}
.field .lab{display:block;font-size:24rpx;font-weight:600;color:var(--ink-2);margin-bottom:12rpx}
.input{width:100%;background:#FBF4E6;border:2rpx solid var(--line);border-radius:20rpx;padding:20rpx 24rpx;min-height:96rpx}
textarea.input{min-height:140rpx}
.inrow{display:flex;gap:16rpx;align-items:center}
.flex1{flex:1}
.form-sec{margin-bottom:32rpx}
.form-sec .h4{font-size:28rpx;font-weight:700;margin-bottom:20rpx;color:var(--ink)}
.form-sec .req{color:var(--red)}
.agree{display:flex;gap:16rpx;align-items:flex-start;margin:8rpx 0 28rpx}
.agree .cb{flex:none;width:40rpx;height:40rpx;border-radius:12rpx;border:2rpx solid var(--line);background:#fff;
  display:flex;align-items:center;justify-content:center;font-size:26rpx;color:#fff;margin-top:4rpx}
.agree .cb.on{background:var(--primary);border-color:var(--primary)}
.agree .agree-t{font-size:22rpx;color:var(--muted);line-height:1.6}

/* ---- 键值行 ---- */
.kv{display:flex;justify-content:space-between;gap:24rpx;padding:14rpx 0;border-bottom:2rpx solid #FAF0DE;font-size:26rpx}
.kv:last-child{border-bottom:none}
.kv .k{color:var(--muted);flex:none;min-width:150rpx}
.kv .v{color:var(--ink);font-weight:600;text-align:right;word-break:break-all}

/* ---- 头像/圆点 ---- */
.avatar{width:96rpx;height:96rpx;border-radius:999rpx;background:linear-gradient(135deg,var(--primary),var(--teal-2));
  color:#fff;display:flex;align-items:center;justify-content:center;font-size:40rpx;font-weight:700;flex:none}
.dot{width:14rpx;height:14rpx;border-radius:999rpx;display:inline-block;flex:none}
.dot.g{background:var(--green);box-shadow:0 0 0 6rpx rgba(5,150,105,.15)}
.dot.r{background:var(--red);box-shadow:0 0 0 6rpx rgba(220,38,38,.15)}

/* ---- 时间线 ---- */
.tl-item{display:flex;gap:20rpx;align-items:flex-start;padding:18rpx 0;border-bottom:2rpx solid #FBF4E6}
.tl-item:last-child{border-bottom:none}
.tl-ic{flex:none;width:56rpx;height:56rpx;border-radius:18rpx;background:var(--mint);display:flex;align-items:center;justify-content:center;font-size:30rpx}
.tl-item.r .tl-ic{background:var(--red-bg)}
.tl-item.g .tl-ic{background:var(--green-bg)}
.tl-main{flex:1;min-width:0;font-size:26rpx;font-weight:600;color:var(--ink-2);line-height:1.5}
.tl-time{flex:none;font-size:22rpx;color:var(--muted)}

/* ---- 用药项 ---- */
.med-item{display:flex;gap:20rpx;align-items:center;padding:20rpx;background:#FBF4E6;border-radius:20rpx;margin-bottom:16rpx}
.med-item.due{background:var(--amber-bg)}
.med-item.taken{background:var(--green-bg)}
.med-ic{flex:none;width:64rpx;height:64rpx;border-radius:20rpx;background:#fff;display:flex;align-items:center;justify-content:center;font-size:34rpx}
.med-main{flex:1;min-width:0;display:flex;flex-direction:column}
.med-main .b{font-size:28rpx;font-weight:700}
.med-main .s{font-size:22rpx;color:var(--muted)}
.med-time{flex:none;font-size:26rpx;font-weight:700;color:var(--primary-dark);font-variant-numeric:tabular-nums}
.btn-take{flex:none;background:var(--primary);color:#fff;border-radius:999rpx;padding:12rpx 28rpx;font-size:24rpx;font-weight:700}

/* ---- 设备项 ---- */
.dev-item{display:flex;gap:20rpx;align-items:center;padding:22rpx;background:#FBF4E6;border-radius:20rpx;margin-bottom:16rpx;border:2rpx solid transparent}
.dev-item.warn{background:var(--red-bg);border-color:#FECACA}
.dev-item .ic{flex:none;width:64rpx;height:64rpx;border-radius:20rpx;background:#fff;display:flex;align-items:center;justify-content:center;font-size:34rpx}
.dev-main{flex:1;min-width:0;display:flex;flex-direction:column}
.dev-main .b{font-size:27rpx;font-weight:700}
.dev-main .s{font-size:22rpx;color:var(--muted)}

/* ---- 告警项 ---- */
.alert-item{background:#fff;border:2rpx solid var(--line);border-radius:28rpx;padding:26rpx;margin-bottom:20rpx}
.alert-item.critical{border-color:#FECACA;background:#FFF7F7}
.alert-item.resolved{opacity:.72}
.alert-item .row1{display:flex;align-items:center;justify-content:space-between;gap:16rpx;margin-bottom:12rpx}
.alert-item .row1 .b{font-size:29rpx;font-weight:700}
.alert-item .meta{display:flex;flex-wrap:wrap;gap:8rpx 24rpx;font-size:22rpx;color:var(--muted);margin-bottom:10rpx}
.alert-item .desc{font-size:24rpx;color:var(--ink-2);line-height:1.6}

/* ---- 顶部操作条（家人端页内） ---- */
.topbar{display:flex;align-items:center;gap:16rpx;padding:8rpx 0 20rpx}
.topbar .logo{display:flex;align-items:center;gap:12rpx;font-weight:700;font-size:28rpx}
.topbar .mark{width:52rpx;height:52rpx;border-radius:18rpx;background:linear-gradient(135deg,var(--primary),var(--teal-2));
  display:flex;align-items:center;justify-content:center;font-size:28rpx}
.elder-chip{display:flex;align-items:center;gap:10rpx;background:var(--mint);border:2rpx solid var(--mint-line);
  border-radius:999rpx;padding:10rpx 20rpx;font-size:24rpx;font-weight:700;color:var(--primary-dark);max-width:260rpx}
.icon-btn{position:relative;width:72rpx;height:72rpx;border-radius:20rpx;display:flex;align-items:center;justify-content:center;font-size:38rpx}
.badge-dot{position:absolute;top:8rpx;right:8rpx;min-width:30rpx;height:30rpx;border-radius:999rpx;background:var(--red);
  color:#fff;font-size:18rpx;font-weight:700;display:flex;align-items:center;justify-content:center;padding:0 6rpx;border:4rpx solid #fff}
.switch-btn{font-size:24rpx;font-weight:700;color:var(--primary-dark);background:var(--teal-soft);border-radius:999rpx;padding:14rpx 22rpx;white-space:nowrap}
.switch-btn:active{transform:scale(.95)}

/* ---- Hero 卡 ---- */
.hero{border-radius:36rpx;padding:32rpx;margin-bottom:24rpx;color:#fff;
  background:linear-gradient(135deg,#FE8E28 0%,#F47B20 45%,#F59E0B 100%);box-shadow:0 16rpx 40rpx -12rpx rgba(254,142,40,.40)}
.hero.alert{background:linear-gradient(135deg,#B91C1C,#DC2626 60%,#F87171)}
.hero .row1{display:flex;align-items:center;justify-content:space-between;margin-bottom:24rpx}
.hero .st-chip{display:flex;align-items:center;gap:10rpx;background:rgba(255,255,255,.16);border-radius:999rpx;padding:8rpx 20rpx;font-size:22rpx;font-weight:600}
.hero .upd{font-size:20rpx;color:rgba(255,255,255,.75)}
.hero .hero-id{display:flex;gap:20rpx;align-items:center;margin-bottom:20rpx}
.hero .avatar{box-shadow:0 0 0 6rpx rgba(255,255,255,.35)}
.hero .nm{font-size:36rpx;font-weight:700;display:flex;align-items:baseline;gap:14rpx}
.hero .nm .age{font-size:24rpx;font-weight:500;color:rgba(255,255,255,.8)}
.hero .sub2{display:flex;gap:12rpx;margin-top:8rpx;flex-wrap:wrap}
.hero .hero-title{font-size:40rpx;font-weight:700;margin-bottom:16rpx;letter-spacing:1rpx}
.hero .sub{display:flex;gap:12rpx;flex-wrap:wrap}
.hero .chip{background:rgba(255,255,255,.16);color:#fff}
.hero .chip.mint{background:rgba(251,230,147,.30);color:#FFF7E8;border:none}
.hero .addr{max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* ---- 三指标 ---- */
.h3grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20rpx;margin-bottom:24rpx}
.h3cell{background:#fff;border:2rpx solid var(--line);border-radius:28rpx;padding:24rpx 16rpx;text-align:center;box-shadow:0 8rpx 24rpx -8rpx rgba(15,23,42,.05)}
.h3cell .v{font-size:40rpx;font-weight:800;color:var(--primary-dark);font-variant-numeric:tabular-nums}
.h3cell .v .u{font-size:20rpx;font-weight:600;color:var(--muted)}
.h3cell .k{font-size:22rpx;color:var(--muted);margin-top:6rpx}

/* ---- 场景（客厅实况） ---- */
.scene{position:relative;border-radius:24rpx;overflow:hidden;height:280rpx;
  background:linear-gradient(180deg,#F4EBDB 0%,#EDE1CC 62%,#E4D5BA 62.5%,#DECFB4 100%)}
.scene.big{height:380rpx}
.window{position:absolute;left:40rpx;top:36rpx;width:120rpx;height:96rpx;border-radius:14rpx;background:linear-gradient(180deg,#BFE3EE,#DFF3F8);border:6rpx solid #fff}
.sofa{position:absolute;right:36rpx;bottom:56rpx;width:180rpx;height:64rpx;border-radius:22rpx;background:#C9A27A}
.table{position:absolute;left:60rpx;bottom:56rpx;width:96rpx;height:34rpx;border-radius:12rpx;background:#C9A97C}
.plant{position:absolute;right:220rpx;bottom:60rpx;font-size:44rpx}
.floor-line{position:absolute;left:0;right:0;top:62%;height:4rpx;background:rgba(255,255,255,.7)}
.scan{position:absolute;left:0;right:0;top:0;height:4rpx;background:linear-gradient(90deg,transparent,rgba(254,142,40,.85),transparent);
  animation:scan 2.6s linear infinite}
@keyframes scan{0%{top:0}100%{top:100%}}
.figure{position:absolute;left:50%;bottom:52rpx;transform:translateX(-50%);transition:all .5s ease;display:flex;flex-direction:column;align-items:center}
.figure .head{width:34rpx;height:34rpx;border-radius:50%;background:#C2410C}
.figure .body{width:22rpx;height:76rpx;border-radius:12rpx;background:#C2410C;margin-top:6rpx}
.figure.lying{transform:translateX(-50%) rotate(90deg);transform-origin:center 60%}
.cam-meta{position:absolute;left:20rpx;top:20rpx;display:flex;align-items:center;gap:10rpx;font-size:20rpx;color:#fff;
  background:rgba(15,23,42,.42);border-radius:14rpx;padding:6rpx 16rpx}
.rec{width:14rpx;height:14rpx;border-radius:50%;background:#EF4444;display:inline-block;animation:blink 1.2s infinite}
@keyframes blink{0%,100%{opacity:1}50%{opacity:.25}}
.posture-tag{position:absolute;left:20rpx;bottom:20rpx;display:flex;align-items:center;gap:10rpx;border-radius:999rpx;padding:8rpx 20rpx;font-size:22rpx;font-weight:700}
.posture-tag.ok{background:rgba(236,253,245,.95);color:var(--green)}
.posture-tag.fall{background:rgba(254,242,242,.97);color:var(--red)}
.posture-tag .pd{width:12rpx;height:12rpx;border-radius:50%;background:currentColor}
.ai-tag{position:absolute;right:20rpx;top:20rpx;font-size:20rpx;color:#FFF7E8;background:rgba(254,142,40,.92);border-radius:14rpx;padding:6rpx 16rpx}
.scene.alerted{animation:alertPulse 1s infinite}
@keyframes alertPulse{0%,100%{box-shadow:inset 0 0 0 0 rgba(220,38,38,0)}50%{box-shadow:inset 0 0 0 10rpx rgba(220,38,38,.55)}}

/* ---- 地图 ---- */
.map{width:100%;height:320rpx;border-radius:24rpx;overflow:hidden}
.loc-meta{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-top:20rpx}
.loc-meta .addr{flex:1;min-width:0;font-size:24rpx;color:var(--ink-2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.btn-outline.sm{min-height:64rpx;font-size:24rpx;padding:0 24rpx;flex:none}

/* ---- 联络通道 ---- */
.chan{display:flex;gap:20rpx;align-items:center;background:#fff;border:2rpx solid var(--line);border-radius:24rpx;padding:20rpx;margin-bottom:14rpx}
.chan .ic{flex:none;width:64rpx;height:64rpx;border-radius:20rpx;background:var(--mint);display:flex;align-items:center;justify-content:center;font-size:34rpx}
.chan .cm{flex:1;min-width:0;display:flex;flex-direction:column}
.chan .cm .b{font-size:27rpx;font-weight:700}
.chan .cm .s{font-size:22rpx;color:var(--muted)}
.chan-btn{flex:none;background:var(--teal-soft);color:var(--primary-dark);border-radius:999rpx;padding:12rpx 28rpx;font-size:24rpx;font-weight:700;white-space:nowrap}

/* ---- 监控页 ---- */
.dev-tabs{display:flex;gap:14rpx;margin-bottom:24rpx}
.dev-tabs .tab{flex:1;background:#fff;border:2rpx solid var(--line);border-radius:999rpx;padding:18rpx 8rpx;
  font-size:23rpx;font-weight:600;color:var(--muted);text-align:center}
.dev-tabs .tab.on{background:var(--mint);border-color:var(--mint-line);color:var(--primary-dark);font-weight:700}
.mon-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:20rpx}
.mon-head .b{font-size:30rpx;font-weight:700}
.chip.red.live{display:flex;align-items:center;gap:8rpx;font-weight:700}
.ai-bar{margin-top:20rpx;background:linear-gradient(135deg,#FFF7ED,#FFEDD5);border:2rpx solid #FED7AA;border-radius:24rpx;padding:22rpx}
.ai-row{display:flex;justify-content:space-between;align-items:center;margin-bottom:14rpx}
.ai-row .t{font-size:26rpx;font-weight:700;color:#9A3412}
.ai-row .l{font-size:30rpx;font-weight:800;color:#C2410C;font-variant-numeric:tabular-nums}
.ai-track{height:16rpx;background:#FDE8D3;border-radius:999rpx;overflow:hidden}
.ai-fill{height:100%;background:linear-gradient(90deg,#FB923C,#EA580C);border-radius:999rpx;transition:width .25s}
.ai-row2{display:flex;justify-content:space-between;align-items:center;margin-top:14rpx}
.ai-row2 .conf{font-size:24rpx;font-weight:700;color:#C2410C}
.ai-cancel{background:#fff;border:2rpx solid #FED7AA;color:#9A3412;border-radius:999rpx;padding:10rpx 26rpx;font-size:23rpx;font-weight:700}
.mon-acts{display:grid;grid-template-columns:1fr 1fr 1.3fr;gap:16rpx;margin-top:20rpx}
.cam-sub{margin-top:16rpx;font-size:22rpx;color:var(--muted);text-align:center}

/* ---- 告警页签 ---- */
.alert-tabs{display:flex;gap:14rpx;margin-bottom:24rpx}
.alert-tabs .tab{flex:1;background:#fff;border:2rpx solid var(--line);border-radius:999rpx;padding:16rpx 8rpx;
  font-size:25rpx;font-weight:600;color:var(--muted);text-align:center}
.alert-tabs .tab.on{background:var(--primary);border-color:var(--primary);color:#fff;font-weight:700}

/* ---- 弹层（底部弹窗） ---- */
.modal-mask{position:fixed;inset:0;background:rgba(15,23,42,.5);z-index:100;display:flex;align-items:flex-end;justify-content:center}
.modal-box{width:100%;max-height:86vh;background:var(--bg);border-radius:36rpx 36rpx 0 0;padding:16rpx 28rpx 60rpx;overflow-y:auto}
.modal-box .grab{width:80rpx;height:10rpx;border-radius:999rpx;background:#CBD5E1;margin:8rpx auto 20rpx}
.modal-box .mh{display:flex;align-items:center;justify-content:space-between;margin-bottom:8rpx}
.modal-box .mh .t{font-size:34rpx;font-weight:800}
.modal-box .x{width:56rpx;height:56rpx;border-radius:18rpx;background:#FAF0DE;display:flex;align-items:center;justify-content:center;font-size:28rpx;color:var(--muted)}
.verify-box{background:var(--red-bg);border-radius:28rpx;padding:28rpx;margin:20rpx 0}
.verify-row{display:flex;align-items:center;gap:20rpx;margin-bottom:18rpx}
.verify-row .ic{font-size:44rpx}
.verify-row .b{font-size:26rpx;font-weight:700}
.verify-row .s{font-size:22rpx;color:var(--muted)}
.verify-num{margin-left:auto;font-size:56rpx;font-weight:800;color:var(--red);font-variant-numeric:tabular-nums}
.verify-track{height:14rpx;background:#FECACA;border-radius:999rpx;overflow:hidden}
.verify-fill{height:100%;background:var(--red);border-radius:999rpx;transition:width .5s linear}
.snap{position:relative;border-radius:24rpx;overflow:hidden;height:240rpx;background:linear-gradient(135deg,#3B4A52,#6B7D84);margin-bottom:20rpx}
.snap .tg{position:absolute;background:rgba(0,0,0,.4);color:#fff;font-size:20rpx;border-radius:12rpx;padding:4rpx 16rpx}

/* ---- 档案向导 ---- */
.dis-chips{display:flex;flex-wrap:wrap;gap:14rpx}
.dis-chips .dc{background:#FBF4E6;border:2rpx solid var(--line);color:var(--ink-2);border-radius:999rpx;padding:14rpx 26rpx;font-size:25rpx;font-weight:600}
.dis-chips .dc.on{background:var(--amber-bg);border-color:#FCD34D;color:var(--amber);font-weight:700}
.addline{display:flex;align-items:center;justify-content:center;width:100%;border:2rpx dashed var(--mint-line);color:var(--primary-dark);
  border-radius:20rpx;min-height:80rpx;font-size:26rpx;font-weight:700;background:var(--mint)}
.dyn-row{display:flex;gap:12rpx;margin-bottom:14rpx;align-items:center}
.rowdel{flex:none;width:64rpx;height:64rpx;border-radius:18rpx;background:var(--red-bg);color:var(--red);display:flex;align-items:center;justify-content:center;font-size:28rpx}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}
.grid3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12rpx}

/* ---- 空态 ---- */
.empty{text-align:center;color:var(--muted);font-size:24rpx;padding:36rpx 20rpx}
.empty-hero{text-align:center;padding:70rpx 40rpx}
.empty-hero .big{font-size:80rpx}
.empty-hero .t{font-size:32rpx;font-weight:700;margin:16rpx 0 8rpx}
.empty-hero .s{font-size:24rpx;color:var(--muted);margin-bottom:32rpx;line-height:1.7}

/* ---- 登录页 ---- */
.login-wrap{padding:30rpx 32rpx 60rpx}
.login-hero{text-align:center;margin-bottom:40rpx}
.logo-big{width:150rpx;height:150rpx;border-radius:999rpx;background:var(--teal-soft);margin:0 auto 30rpx;
  display:flex;align-items:center;justify-content:center;font-size:72rpx;position:relative;box-shadow:0 16rpx 40rpx -12rpx rgba(254,142,40,.3)}
.lb-dot{position:absolute;right:16rpx;bottom:22rpx;width:22rpx;height:22rpx;border-radius:999rpx;background:var(--primary-dark);box-shadow:0 0 0 4rpx var(--teal-soft)}
.login-hero .h1{font-size:40rpx;font-weight:800;color:var(--ink);letter-spacing:1rpx}
.login-hero .p{font-size:25rpx;color:var(--muted);margin-top:10rpx}
.steps{display:flex;align-items:center;justify-content:center;gap:16rpx;margin-top:28rpx}
.steps .st{font-size:22rpx;font-weight:600;color:var(--muted);background:#FAF0DE;border-radius:999rpx;padding:8rpx 22rpx}
.steps .st.on{background:var(--teal-soft);color:var(--primary-dark);font-weight:700}
.steps .ln{width:40rpx;height:4rpx;background:var(--line);border-radius:999rpx}
.login-tabs{display:flex;background:#FAF0DE;border-radius:999rpx;padding:8rpx;margin-bottom:28rpx}
.login-tabs .tab{flex:1;text-align:center;padding:18rpx 0;font-size:26rpx;font-weight:600;color:var(--muted);border-radius:999rpx}
.login-tabs .tab.on{background:#fff;color:var(--primary-dark);font-weight:700;box-shadow:0 4rpx 12rpx rgba(15,23,42,.08)}
.login-card{border-radius:36rpx;padding:36rpx 32rpx}
.prefix{flex:none;width:130rpx;background:#FBF4E6;border:2rpx solid var(--line);border-radius:20rpx;min-height:96rpx;
  display:flex;align-items:center;justify-content:center;color:var(--muted);font-size:28rpx}
.privacy{display:flex;gap:20rpx;align-items:flex-start;background:var(--mint);border:2rpx solid var(--mint-line);border-radius:24rpx;padding:24rpx;margin-top:28rpx}
.privacy .ic{font-size:36rpx;flex:none}
.privacy .pr-t{font-size:22rpx;color:var(--muted);line-height:1.7}
.privacy .pr-t .b{display:block;color:var(--ink-2);font-size:24rpx;font-weight:700}

/* ============================================================
   极简排版覆盖（与网页版一致 · 配色/功能不变）
   大量留白 · 细线分隔 · 统一小圆角 · 无装饰元素
   ============================================================ */
/* 仅两处大标题用衬线 */
.login-hero .h1,.hero .hero-title{font-family:"Songti SC","STSong","SimSun",serif;letter-spacing:2rpx}
/* 卡片：纯平 + 细边框 + 统一圆角 */
.card,.h3cell,.alert-item,.chan{border-radius:20rpx;box-shadow:none;border-color:#EDE1CB}
.card-h{padding-bottom:20rpx;border-bottom:2rpx solid var(--line)}
.card-h .b{font-size:30rpx;letter-spacing:2rpx}
/* 按钮：扁平、微圆角 */
.btn-primary,.btn-green,.btn-red,.btn-outline,.btn-mint,.btn-warn,
.btn-take,.chan-btn,.switch-btn,.ai-cancel{border-radius:16rpx;letter-spacing:2rpx}
/* chip / 页签：统一小圆角 */
.chip,.elder-chip,.dis-chips .dc{border-radius:12rpx}
.login-tabs{border-radius:16rpx}
.login-tabs .tab,.dev-tabs .tab,.alert-tabs .tab{border-radius:12rpx}
/* 页内顶栏 */
.topbar .mark{border-radius:12rpx}
.icon-btn{border-radius:16rpx}
/* 登录页：左对齐、留白 */
.login-hero{text-align:left}
.logo-big{margin:0 0 44rpx;border-radius:28rpx}
.login-hero .h1{font-size:60rpx;line-height:1.35}
.login-hero .p{margin-top:16rpx}
.steps{justify-content:flex-start}
.steps .st{border-radius:12rpx;background:transparent;border:2rpx solid var(--line)}
.steps .st.on{background:var(--primary);border-color:var(--primary);color:#fff}
.input,.prefix{border-radius:16rpx}
.privacy{border-radius:20rpx}
/* Hero：平、净 */
.hero{border-radius:24rpx;box-shadow:none}
.hero .hero-title{font-size:42rpx}
.hero .avatar{border-radius:20rpx;box-shadow:0 0 0 4rpx rgba(255,255,255,.35)}
/* 列表统一圆角 */
.med-item,.med-ic,.dev-item .ic,.tl-ic,.map,.scene{border-radius:20rpx}
.chan .ic{border-radius:16rpx}
.modal-box{border-radius:32rpx 32rpx 0 0}
/* 老人端大按钮、监控场景等功能区保持原样 */

/* 选择性升级救援面板 */
.esc-card{background:#fff}
.esc-row{display:flex;gap:16rpx;align-items:flex-start;padding:20rpx 16rpx;border:2rpx solid var(--line);border-radius:16rpx;margin-bottom:12rpx}
.esc-row.on{border-color:var(--primary);background:#FFF7E8}
.esc-row.dim{opacity:.55}
.esc-cb{width:38rpx;height:38rpx;flex:none;border-radius:10rpx;border:2rpx solid #CBD5E1;display:flex;align-items:center;justify-content:center;font-size:24rpx;color:#fff;margin-top:4rpx}
.esc-row.on .esc-cb{background:var(--primary);border-color:var(--primary)}
.esc-m{flex:1;min-width:0;display:flex;flex-direction:column;gap:4rpx}
.esc-m .b{font-size:28rpx;font-weight:600}
.esc-m .s{font-size:22rpx;color:var(--muted);line-height:1.5}
